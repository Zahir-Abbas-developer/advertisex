// Advertise X — Prisma schema
//
// Development runs on SQLite. The schema is deliberately kept
// Postgres-compatible so the only change needed at deploy time is the
// datasource block below (provider = "postgresql").
//
// Postgres-compatibility rules observed throughout:
//   - String IDs generated with cuid() (no autoincrement / serial).
//   - Enums are modelled as String + a documented union of allowed values,
//     because SQLite has no native enum. Constants live in lib/constants.ts,
//     which is the single source of truth for both DB writes and UI.
//   - No SQLite-only column types, no Json columns, no array columns.
//   - Every timestamp is DateTime, stored UTC, formatted for Asia/Karachi in
//     the UI via lib/date.ts. Date-only fields (startDate, endDate, dueDate)
//     are stored at UTC midnight of the intended calendar day.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Phase 1 (Advertise X) — Tenancy
// ---------------------------------------------------------------------------

/// A SaaS tenant. Advertise X itself is organization #1; future tenants are
/// other agencies or direct restaurant tenants (CLAUDE.md §5, ADR-005).
///
/// Tenancy keys sit on the roots — User, Department, Client, ClientAccount —
/// and child rows reach their organization through their root (a FieldValue
/// belongs to a Lead, which belongs to a Department, which belongs here).
/// Denormalised organizationId columns spread to child tables when
/// Row-Level Security lands on Postgres, not before (ADR-005).
model Organization {
  id        String   @id @default(cuid())
  /// Stable machine key, e.g. "advertisex". URLs and seeds reference it.
  slug      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  departments    Department[]
  clients        Client[]
  clientAccounts ClientAccount[]
  agentGrants    AgentGrant[]
  skills         Skill[]
  files          File[]
  savedViews     SavedView[]
  services       ServiceCatalog[]
  clientServices ClientService[]
  contracts      Contract[]
  credentials    ClientCredential[]
  clientNotes    ClientNote[]
  projects       Project[]
  clientInvites  ClientInvite[]
  clientReports  ClientReport[]
  threads        MessageThread[]
  invoices       Invoice[]
  payments       Payment[]
  announcements  Announcement[]
  metrics        MetricValue[]
  connections    IntegrationConnection[]
  snapshots      AnalyticsSnapshot[]

  // Phase 7 — billing. The organization is the seller on every invoice.
  /// Printed before the number: "INV" gives INV-0001.
  invoicePrefix     String  @default("INV")
  /// The next number to issue. Numbers are taken when an invoice is sent
  /// (drafts have none), so the sequence has no gaps.
  nextInvoiceNumber Int     @default(1)
  /// ISO 4217. The financial overview reports in this currency.
  currency          String  @default("USD")
  /// Days from issue to due, unless an invoice says otherwise.
  paymentTermsDays  Int     @default(14)
  /// Printed on invoices as the seller's address (multi-line).
  billingAddress    String?
  billingEmail      String?
}

/// A restaurant client as a *portal tenant* — the thing a CLIENT login is
/// scoped to. A skeleton in Phase 1: the portal experience is a later phase.
///
/// Deliberately distinct from `Client`, which is the CRM record of the
/// commercial relationship (pipeline, budget, status). The optional link on
/// Client ties the two together where both exist; a ClientAccount can predate
/// its CRM record and vice versa.
model ClientAccount {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// "ACTIVE" | "SUSPENDED" — see CLIENT_ACCOUNT_STATUSES in lib/constants.ts.
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  clients      Client[]
  invites      ClientInvite[]

  @@index([organizationId])
}

/// One explicit permission held by an AI_AGENT user (CLAUDE.md §5: "AI agents
/// are users of type AI_AGENT with explicit permissions"). The permissions
/// matrix gives AI_AGENT the `grant` scope on a few resources; a cell with
/// that scope allows the action only when a row here names that exact
/// resource and action. No row, no access — the role alone grants nothing.
model AgentGrant {
  id             String   @id @default(cuid())
  organizationId String
  agentId        String
  /// A Resource from config/permissions.ts, e.g. "lead".
  resource       String
  /// An Action from config/permissions.ts, e.g. "read".
  action         String
  /// Who approved it — every grant is a human decision.
  grantedById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent        User         @relation("AgentGrants", fields: [agentId], references: [id], onDelete: Cascade)
  grantedBy    User?        @relation("AgentGrantsIssued", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([agentId, resource, action])
  @@index([organizationId])
  @@index([grantedById])
}

// ---------------------------------------------------------------------------
// Phase 2 (Advertise X) — Team operating system
// ---------------------------------------------------------------------------

/// One entry in the organization's skills taxonomy ("Google Ads", "SEO").
/// Seeded with the Phase 2 catalog; the founder extends it. Deactivating a
/// skill hides it from pickers without deleting who holds it.
model Skill {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  /// Grouping for display, e.g. "Paid media", "Creative".
  category       String   @default("General")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  holders         UserSkill[]
  services        ServiceSkill[]
  projects        ProjectSkill[]
  recommendations AssignmentRecommendation[]
  reassignments   ReassignmentSuggestion[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

/// A person's (or an agent's) skill, with proficiency 1–5.
model UserSkill {
  id          String   @id @default(cuid())
  userId      String
  skillId     String
  /// 1 = learning … 5 = expert.
  proficiency Int
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([skillId])
}

/// A person's agreed working schedule — what attendance is measured against.
/// Absent means the default (Mon–Fri 09:00–17:00, company timezone). AI
/// agents have none: attendance does not apply to them.
model WorkSchedule {
  id           String   @id @default(cuid())
  userId       String   @unique
  /// IANA timezone the schedule is read in, e.g. "America/New_York".
  timezone     String
  /// ISO weekdays, comma-separated: "1,2,3,4,5" = Mon–Fri.
  workDays     String   @default("1,2,3,4,5")
  /// Minutes past local midnight.
  startMinute  Int      @default(540)
  endMinute    Int      @default(1020)
  graceMinutes Int      @default(5)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A checklist line on a task.
model TaskChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  label     String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, order])
}

/// A comment on a task.
model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  task   Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User? @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

/// An uploaded file, stored privately and served only through an authorized
/// route. Attached to a task for now; other owners join as their phases land.
model File {
  id             String   @id @default(cuid())
  organizationId String
  uploaderId     String?
  /// Exactly one owner: a task, a client, a project or a contract.
  taskId         String?
  clientId       String?
  projectId      String?
  contractId     String?
  /// Phase 6: a file shared in a message (visible to that thread's readers).
  messageId      String?
  /// Original name, shown to people. Never used for filesystem access.
  filename       String
  /// Generated name in storage, e.g. "<cuid>.png".
  storedName     String   @unique
  mimeType       String
  size           Int
  /// "INTERNAL" | "CLIENT" — whether a client may ever see it.
  visibility     String   @default("INTERNAL")
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploader     User?         @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  task         Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contract     Contract?     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  report       ClientReport?

  @@index([organizationId])
  @@index([taskId])
  @@index([uploaderId])
  @@index([clientId])
  @@index([projectId])
  @@index([contractId])
  @@index([messageId])
}

// ---------------------------------------------------------------------------
// Phase 3 (Advertise X) — Lead pipeline & outreach
// ---------------------------------------------------------------------------

/// One move of a lead between stages — the history stage velocity is
/// measured from. Written by the single stage-move path (lib/stages.ts), in
/// the same transaction as the move.
model LeadStageEvent {
  id           String   @id @default(cuid())
  leadId       String
  departmentId String
  /// Null for the lead's first stage (its creation).
  fromStage    String?
  toStage      String
  userId       String?
  at           DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, at])
  @@index([departmentId, at])
}

/// A named set of pipeline filters a person saved for reuse.
model SavedView {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  /// What the view filters — "LEADS" for now.
  scope          String   @default("LEADS")
  name           String
  /// Serialized filters, validated by modules/leads/domain.ts on read.
  filters        String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("SavedViews", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, name])
  @@index([organizationId])
}

/// A person who can sign in — a team member, the founder, a client contact or
/// an AI agent. Role names and their meaning live in lib/constants.ts.
model User {
  id                  String   @id @default(cuid())
  name                String
  email               String   @unique
  passwordHash        String
  /// "FOUNDER" | "MANAGER" | "EMPLOYEE" | "CLIENT" | "AI_AGENT" — see Role in
  /// lib/constants.ts. Rows written before the Advertise X role model may
  /// still hold the legacy values "ADMIN" | "SUPPORT_ADMIN" | "MEMBER"; every
  /// read normalises through normalizeRole(), and authority checks go through
  /// hasAdminPower(), never string comparison.
  role                String   @default("EMPLOYEE")
  /// Nullable only for rows that predate tenancy; the seed backfills it and
  /// new accounts always carry it. Treated as required by the data layer.
  organizationId      String?
  /// CLIENT logins only: the single restaurant account this user is scoped to.
  clientAccountId     String?
  /// CLIENT logins only: "OWNER" (invites people, sees invoices) | "MEMBER".
  clientRole          String?
  /// JSON notification preferences, e.g. {"messages":true,"reports":true,"updates":true}.
  notificationPrefs   String   @default("{}")
  /// What this person owns day to day, in their own words or the founder's.
  responsibilities    String?
  /// "ACTIVE" | "ON_LEAVE" | "INACTIVE" — shown on the profile; sign-in is
  /// governed by isActive alone.
  employmentStatus    String   @default("ACTIVE")
  /// Delivery specialism, e.g. "Shopify Developer", "Media Buyer".
  jobTitle            String
  /// E.164, e.g. "+923001234567". Only used for the optional WhatsApp channel;
  /// with WHATSAPP_* unset it is never read.
  phone               String?
  /// Hours of delivery work this person can absorb in a week. Drives the
  /// capacity bars at every point where work is assigned.
  weeklyCapacityHours Int      @default(40)
  /// Hex colour used for the member's avatar chip, from AVATAR_COLORS.
  avatarColor         String   @default("#1A6B3A")
  /// Carries the sales pipeline, and with it the right to see deal values.
  ///
  /// An explicit flag rather than a jobTitle match: the Production Doctrine
  /// gates agency money on this, and a permission that turns on because
  /// someone's free-text title happens to contain "Business Developer" is a
  /// permission that changes when a title is edited for cosmetic reasons.
  isBusinessDev       Boolean  @default(false)
  /// Seeded accounts ship with a placeholder password. While this is true the
  /// app forces a change before anything else is reachable, so a placeholder
  /// credential cannot survive first contact with a real user.
  mustChangePassword  Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  milestones         Milestone[]                @relation("MilestoneAssignee")
  scoreEvents        ScoreEvent[]               @relation("ScoreEventSubject")
  authoredScore      ScoreEvent[]               @relation("ScoreEventAuthor")
  reports            Report[]
  notifications      Notification[]
  comments           Comment[]
  mentions           CommentMention[]
  attachments        Attachment[]
  activity           Activity[]                 @relation("ActivityActor")
  attendance         AttendanceDay[]
  leaveRequests      LeaveRequest[]             @relation("LeaveSubject")
  leaveReviews       LeaveRequest[]             @relation("LeaveReviewer")
  outages            OutageReport[]             @relation("OutageSubject")
  outageReviews      OutageReport[]             @relation("OutageReviewer")
  breaks             BreakSession[]
  pushSubs           PushSubscription[]
  blocksRaised       BlockPeriod[]              @relation("BlockAuthor")
  blocksCleared      BlockPeriod[]              @relation("BlockReleaser")
  leads              Lead[]                     @relation("LeadOwner")
  leadsCreated       Lead[]                     @relation("LeadCreator")
  salesActivity      SalesActivity[]
  targets            ActivityTarget[]
  kpiEntries         ClientKpiEntry[]           @relation("KpiAuthor")
  leadsServices      ServiceLead[]
  disputes           Dispute[]                  @relation("DisputeSubject")
  disputeFiles       DisputeFile[]
  disputeRulings     Dispute[]                  @relation("DisputeResolver")
  auditEntries       AuditLog[]                 @relation("AuditActor")
  incentives         IncentiveAward[]
  departments        DepartmentMembership[]
  clientsOwned       Client[]                   @relation("ClientAssignee")
  organization       Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  clientAccount      ClientAccount?             @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  agentGrants        AgentGrant[]               @relation("AgentGrants")
  skills             UserSkill[]
  schedule           WorkSchedule?
  taskComments       TaskComment[]              @relation("TaskCommentAuthor")
  filesUploaded      File[]                     @relation("FileUploader")
  savedViews         SavedView[]                @relation("SavedViews")
  grantsIssued       AgentGrant[]               @relation("AgentGrantsIssued")
  tasksAssigned      Task[]                     @relation("TaskAssignee")
  tasksCreated       Task[]                     @relation("TaskCreator")
  projectsLed        Project[]                  @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  projectMilestones  ProjectMilestone[]         @relation("ProjectMilestoneAssignee")
  projectComments    ProjectComment[]           @relation("ProjectCommentAuthor")
  clientNotes        ClientNote[]               @relation("ClientNoteAuthor")
  credentialsCreated ClientCredential[]         @relation("CredentialCreator")
  recommendedFor     AssignmentRecommendation[] @relation("RecommendedFor")
  chosenFor          AssignmentRecommendation[] @relation("ChosenFor")
  assignmentsDecided AssignmentRecommendation[] @relation("AssignmentDecider")
  reassignFrom       ReassignmentSuggestion[]   @relation("ReassignFrom")
  reassignTo         ReassignmentSuggestion[]   @relation("ReassignTo")
  reassignDecided    ReassignmentSuggestion[]   @relation("ReassignDecider")
  invitesSent        ClientInvite[]             @relation("InviteSender")
  projectUpdates     ProjectUpdate[]            @relation("ProjectUpdateAuthor")
  reportsUploaded    ClientReport[]             @relation("ReportUploader")
  reportReads        ClientReportRead[]
  messages           Message[]                  @relation("MessageAuthor")
  threadReads        ThreadRead[]
  invoicesCreated    Invoice[]                  @relation("InvoiceCreator")
  paymentsRecorded   Payment[]                  @relation("PaymentRecorder")
  paymentsReversed   Payment[]                  @relation("PaymentReverser")
  reportsReviewed    ClientReport[]             @relation("ReportReviewer")
  announcements      Announcement[]
  metricsEntered     MetricValue[]

  @@index([role])
  @@index([isActive])
  @@index([organizationId])
  @@index([clientAccountId])
}

// ---------------------------------------------------------------------------
// Phase 2 — Clients, engagements, modules and milestones
// ---------------------------------------------------------------------------

/// An e-commerce business on a monthly retainer.
model Client {
  id              String    @id @default(cuid())
  /// Nullable only for rows that predate tenancy; backfilled by the seed.
  organizationId  String?
  /// The portal tenant for this relationship, once one exists (skeleton in
  /// Phase 1 — created when the client portal opens for the account).
  clientAccountId String?
  /// The business line this client belongs to. Required: a client with no
  /// department is invisible to department-scoped queries, which is a silent
  /// data-loss bug rather than a display one.
  departmentId    String
  businessName    String
  contactName     String
  email           String
  phone           String?
  country         String?
  industry        String?
  /// Carried over from the lead on conversion (Phase 3) — no re-entry.
  website         String?
  location        String?
  /// Comma-separated, lower-case, as on Lead.
  tags            String    @default("")
  /// Whole currency units (USD). Integer, never Float — money is not binary.
  monthlyBudget   Int       @default(0)
  /// "LEAD" | "ACTIVE" | "PAUSED" | "CHURNED" — see CLIENT_STATUSES.
  status          String    @default("LEAD")
  notes           String?
  onboardedAt     DateTime  @default(now())
  /// When false the nightly job never opens a new cycle for this client —
  /// for bespoke schedules, or a retainer being wound down.
  autoRenew       Boolean   @default(true)
  /// Return on ad spend this client's campaigns are held to. Null falls back
  /// to the agency default in Settings.
  targetRoas      Float?
  /// Who owns this relationship. A core column rather than a dynamic field:
  /// every department has an assignee, and it is filtered on constantly.
  assigneeId      String?
  /// The next thing owed to this client. Core for the same reason — it drives
  /// the follow-up views every department needs.
  nextFollowUpAt  DateTime?
  /// Phase 8 — when the client became CHURNED (null otherwise); client retention reads it.
  churnedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  department    Department              @relation(fields: [departmentId], references: [id])
  assignee      User?                   @relation("ClientAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  organization  Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  clientAccount ClientAccount?          @relation(fields: [clientAccountId], references: [id], onDelete: SetNull)
  projects      Project[]
  reports       Report[]
  lead          Lead?
  kpis          ClientKpiEntry[]
  activities    SalesActivity[]
  tasks         Task[]
  services      ClientService[]
  contracts     Contract[]
  credentials   ClientCredential[]
  clientNotes   ClientNote[]
  files         File[]
  reportLibrary ClientReport[]
  threads       MessageThread[]
  invoices      Invoice[]
  metrics       MetricValue[]
  connections   IntegrationConnection[]

  @@index([departmentId, status])
  @@index([assigneeId])
  @@index([nextFollowUpAt])
  @@index([status])
  @@index([businessName])
  @@index([organizationId])
  @@index([clientAccountId])
}

/// The agency's offerings. Seeded, and editable by the owner.
model ServiceCatalog {
  id             String   @id @default(cuid())
  /// Nullable only for rows that predate tenancy; backfilled by the seed.
  organizationId String?
  name           String
  /// Stable key used to look up the built-in planning template. Renaming a
  /// service in the UI must not orphan its template, so the slug never changes.
  slug           String
  description    String?
  /// Whole currency units (USD), per `billing` period. 0 = priced per deal.
  price          Int      @default(0)
  /// "ONE_TIME" | "MONTHLY" | "QUARTERLY" | "YEARLY" — see modules/services.
  billing        String   @default("ONE_TIME")
  isActive       Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  organization   Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects       ProjectService[]
  modules        Module[]
  leads          ServiceLead[]
  skills         ServiceSkill[]
  stageTemplates ServiceStageTemplate[]
  clientServices ClientService[]
  invoiceLines   InvoiceLine[]
  projectStages  ProjectStage[]

  @@unique([organizationId, name])
  @@unique([organizationId, slug])
  @@index([isActive])
}

/// The skills a service needs — what a project's required skills are derived from.
model ServiceSkill {
  serviceId String
  skillId   String
  /// 1–5: how central this skill is to the service (drives assignment).
  weight    Int    @default(3)

  service ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  skill   Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([serviceId, skillId])
  @@index([skillId])
}

/// A service's stage template, e.g. Website: Planning → Design → Development
/// → Testing → Launch. Copied onto a project when the service is added, so
/// editing the template never rewrites work already under way.
model ServiceStageTemplate {
  id        String   @id @default(cuid())
  serviceId String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  service ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, order])
}

// ---------------------------------------------------------------------------
// Phase 4 (Advertise X) — Client management
// ---------------------------------------------------------------------------

/// A service a client has bought, at the price and cadence agreed for them.
model ClientService {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  serviceId      String
  /// Whole currency units per `billing` period, as agreed with this client.
  price          Int       @default(0)
  billing        String    @default("ONE_TIME")
  /// "ACTIVE" | "PAUSED" | "ENDED"
  status         String    @default("ACTIVE")
  startDate      DateTime
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service      ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([clientId, status])
  @@index([serviceId])
}

/// An agreement with a client: its dates, status, value and signed files.
model Contract {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  title          String
  /// "DRAFT" | "SENT" | "SIGNED" | "ACTIVE" | "EXPIRED" | "TERMINATED"
  status         String    @default("DRAFT")
  startDate      DateTime?
  endDate        DateTime?
  signedAt       DateTime?
  /// Whole currency units, the contract's total value. 0 when not stated.
  value          Int       @default(0)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  files        File[]

  @@index([organizationId])
  @@index([clientId, status])
  @@index([endDate])
}

/// One login held for a client (their website admin, ad accounts…). The
/// secret is sealed with AES-256-GCM (modules/vault) and bound to this row's
/// id; it is never returned by a list, only by an audited reveal.
model ClientCredential {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  label          String
  /// "WEBSITE" | "HOSTING" | "DOMAIN" | "GOOGLE" | "META" | "SOCIAL" | "EMAIL" | "OTHER"
  kind           String    @default("OTHER")
  url            String?
  username       String?
  /// Sealed: "v1.<keyId>.<iv>.<tag>.<ciphertext>". Never plaintext.
  secret         String
  notes          String?
  createdById    String?
  lastRevealedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("CredentialCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clientId])
  @@index([createdById])
}

/// A note about a client. Pinned notes are the "important notes" at the top
/// of the profile.
model ClientNote {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  authorId       String?
  body           String
  pinned         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author       User?        @relation("ClientNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clientId, pinned])
  @@index([authorId])
}

// ---------------------------------------------------------------------------
// Phase 11 — Delegation, incentives, disputes, audit
// ---------------------------------------------------------------------------

/// Who leads a service line.
///
/// A Service Lead can approve, reject and excuse **within their services
/// only**, and never on their own work. That constraint is the whole point:
/// delegation that let someone sign off their own milestones would make the
/// score self-reported, which is what the approval model has refused since
/// Phase 3.
model ServiceLead {
  userId    String
  serviceId String
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  service ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([userId, serviceId])
  @@index([serviceId])
}

/// A member's formal challenge to one score event.
///
/// The point is that arguments about points stop happening in chat. A dispute
/// has a written case, a named decision, a response, and a deadline — and
/// whichever way it goes, the original event survives.
model Dispute {
  id             String    @id @default(cuid())
  scoreEventId   String    @unique
  userId         String
  /// The member's case.
  reason         String
  /// "OPEN" | "UPHELD" | "REVERSED"
  status         String    @default("OPEN")
  resolvedById   String?
  resolvedAt     DateTime?
  /// Required on either outcome — a decision with no reasoning is the thing
  /// this feature exists to replace.
  responseNote   String?
  /// True when a Service Lead ruled rather than the owner.
  resolvedAsLead Boolean   @default(false)
  createdAt      DateTime  @default(now())

  scoreEvent ScoreEvent    @relation(fields: [scoreEventId], references: [id], onDelete: Cascade)
  user       User          @relation("DisputeSubject", fields: [userId], references: [id], onDelete: Cascade)
  resolvedBy User?         @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  files      DisputeFile[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// Evidence attached to a dispute. Separate from milestone attachments because
/// the retention question is different — a dispute file is part of a decision
/// record, not a working file.
model DisputeFile {
  id         String   @id @default(cuid())
  disputeId  String
  uploaderId String
  filename   String
  storedName String   @unique
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  dispute  Dispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([disputeId])
}

/// What a run of good — or bad — months earns.
///
/// Written by the month-close pass, one row per member per type per month, so
/// re-running the close is a no-op rather than a second bonus.
model IncentiveAward {
  id           String    @id @default(cuid())
  userId       String
  /// "EXCELLENCE_STREAK" | "PERFORMANCE_REVIEW"
  type         String
  year         Int
  month        Int
  /// Consecutive qualifying months at the point it was awarded.
  streakMonths Int       @default(0)
  /// Frozen evidence: the scores, events and attendance behind the decision.
  /// Serialised JSON in a String column, like Report.payload.
  evidence     String
  /// Payroll reference only — this app never moves money.
  bonusAmount  Float?
  bonusPercent Float?
  /// Set when the owner has actioned it, so the list is a queue not an archive.
  actionedAt   DateTime?
  actionedNote String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, year, month])
  @@index([type, year, month])
  @@index([userId, createdAt])
}

/// Every sensitive action, with what changed.
///
/// Separate from Activity: that is a milestone's story, written for the team
/// and rendered in a feed. This is the record of who exercised authority —
/// score adjustments, dispute rulings, role changes, settings edits, excusals —
/// and it is written for the person asking "who did that, and what was it
/// before?".
model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  /// "HUMAN" | "AI" | "CLIENT" | "SYSTEM" — who, in kind, acted. Null on rows
  /// written before Phase 1.
  actorType      String?
  /// The tenant the change belongs to. Null for pre-Phase-1 rows (backfilled
  /// by the seed) and for scheduled-job rows, which run without an actor.
  organizationId String?
  /// "SCORE_ADJUSTED" | "DISPUTE_RESOLVED" | "ROLE_CHANGED" | "SETTINGS_EDITED"
  /// | "CHECK_EXCUSED" | "OUTAGE_REVIEWED" | "MILESTONE_APPROVED"
  /// | "MILESTONE_REJECTED" | "BLOCK_VETOED" | "LEAD_ASSIGNED"
  action         String
  /// What kind of thing was acted on, and which one.
  entityType     String
  entityId       String?
  /// One line, pre-rendered: "Approved 'Campaign launch' at 4 stars".
  summary        String
  /// Serialised JSON of the fields that changed, before and after. Null for
  /// actions where "before" is meaningless.
  beforeJson     String?
  afterJson      String?
  /// True when the actor was exercising Service Lead authority rather than
  /// being the owner. Every delegated action is tagged.
  asLead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
}

/// The last run of each scheduled job, so silent failures become loud.
model JobRun {
  /// The job's name is its identity — one row per job, updated in place.
  job        String    @id
  startedAt  DateTime
  finishedAt DateTime?
  /// "RUNNING" | "OK" | "FAILED"
  status     String    @default("RUNNING")
  /// One line of what it did, or the error.
  summary    String?
  durationMs Int?

  @@index([status])
}

/// A database backup attempt.
model BackupRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// "RUNNING" | "OK" | "FAILED" | "SKIPPED"
  status     String    @default("RUNNING")
  /// Where it went — a path or an object key.
  location   String?
  sizeBytes  Int?
  error      String?

  @@index([startedAt])
}

/// One engagement cycle for one client — normally a calendar month.
model Project {
  id             String    @id @default(cuid())
  /// Nullable only for rows that predate tenancy; backfilled by the seed.
  organizationId String?
  clientId       String
  /// The project's name.
  title          String
  description    String?
  startDate      DateTime
  /// The deadline. Date-only, stored at UTC midnight of the intended day.
  endDate        DateTime
  /// "PLANNING" | "ACTIVE" | "ON_HOLD" | "COMPLETED" | "CANCELLED" — see
  /// modules/projects/domain.ts. Legacy "OVERDUE_CLOSEOUT" reads as COMPLETED.
  status         String    @default("PLANNING")
  /// "LOW" | "MEDIUM" | "HIGH" | "URGENT"
  priority       String    @default("MEDIUM")
  /// Who runs the project.
  ownerId        String?
  /// Set by the delayed-project job the first time the project is found
  /// delayed (so it notifies once); cleared when it is back on track.
  delayedAt      DateTime?
  completedAt    DateTime?
  /// Set by the evaluation job when the cycle is closed out, so close-out
  /// runs exactly once per project.
  closedOutAt    DateTime?
  /// The cycle this one was rolled forward from. Also the idempotency guard:
  /// a project can only ever be renewed once, because a second attempt would
  /// find a child already pointing at it.
  renewedFromId  String?   @unique
  /// Set when the nightly job rolls the cycle forward. An archived project is
  /// read-only in the UI but stays in reports and in the ledger.
  archivedAt     DateTime?

  // --- Retainer payment (Phase 10) -----------------------------------------
  /// "PENDING" | "PAID" | "OVERDUE". A cycle is the unit that gets invoiced,
  /// so payment lives here rather than on the client.
  paymentStatus String    @default("PENDING")
  paidAt        DateTime?
  invoiceNote   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client          Client                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organization    Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  owner           User?                      @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  services        ProjectService[]
  modules         Module[]
  members         ProjectMember[]
  skills          ProjectSkill[]
  stages          ProjectStage[]
  milestones      ProjectMilestone[]
  comments        ProjectComment[]
  files           File[]
  recommendations AssignmentRecommendation[]
  reassignments   ReassignmentSuggestion[]

  renewedFrom Project?        @relation("ProjectRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewedInto Project?        @relation("ProjectRenewal")
  tasks       Task[]
  updates     ProjectUpdate[]
  threads     MessageThread[]
  invoices    Invoice[]

  @@index([clientId])
  @@index([status])
  @@index([endDate])
  @@index([paymentStatus])
  @@index([organizationId, status])
  @@index([ownerId])
}

/// Who works on a project. "LEAD" | "MEMBER".
model ProjectMember {
  projectId String
  userId    String
  role      String   @default("MEMBER")
  addedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

/// A skill the project needs. "DERIVED" rows come from its services' skills;
/// "MANUAL" rows were added by hand. Removing either is allowed.
model ProjectSkill {
  projectId String
  skillId   String
  /// "DERIVED" (from services) | "BRIEF" (read from the brief by AI) | "MANUAL"
  source    String @default("DERIVED")
  /// 1–5: how much of the project needs it — the role's weight in assignment.
  weight    Int    @default(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
}

/// One stage of a project's plan, copied from its service's template.
/// "PENDING" | "ACTIVE" | "DONE".
model ProjectStage {
  id          String    @id @default(cuid())
  projectId   String
  serviceId   String?
  name        String
  order       Int       @default(0)
  status      String    @default("PENDING")
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service    ServiceCatalog?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  milestones ProjectMilestone[]

  @@index([projectId, order])
  @@index([serviceId])
}

/// A dated checkpoint in a project, optionally inside a stage. Counts toward
/// progress by its weight (modules/projects/domain.ts · projectProgress).
/// Distinct from the parked retainer `Milestone`, which carries scoring.
model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  stageId     String?
  title       String
  description String?
  /// Date-only, stored at UTC midnight of the intended day.
  dueDate     DateTime?
  /// "OPEN" | "DONE"
  status      String    @default("OPEN")
  completedAt DateTime?
  /// 1–5: how much of the project this milestone represents.
  weight      Int       @default(1)
  assigneeId  String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage    ProjectStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  assignee User?         @relation("ProjectMilestoneAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([stageId])
  @@index([assigneeId, status])
  @@index([dueDate])
}

/// A recommendation for one role (a required skill) on a project (Phase 5).
/// The founder accepts it, overrides it with someone else, or dismisses it;
/// overrides are the signal fed back into later scoring.
model AssignmentRecommendation {
  id                String    @id @default(cuid())
  projectId         String
  skillId           String
  /// Null when no one could take the role (a gap).
  recommendedUserId String?
  score             Float?
  /// The plain-language reason, and the gap text when there is no one.
  explanation       String
  /// JSON: the score components and the ranked alternatives with theirs.
  detail            String    @default("{}")
  /// "PROPOSED" | "ACCEPTED" | "OVERRIDDEN" | "DISMISSED" | "GAP"
  status            String    @default("PROPOSED")
  /// Who holds the role now: the recommendation, or the founder's choice.
  chosenUserId      String?
  overrideReason    String?
  /// "RECOMMEND" | "AUTO" — how the decision was made.
  mode              String    @default("RECOMMEND")
  decidedById       String?
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill       Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  recommended User?   @relation("RecommendedFor", fields: [recommendedUserId], references: [id], onDelete: SetNull)
  chosen      User?   @relation("ChosenFor", fields: [chosenUserId], references: [id], onDelete: SetNull)
  decidedBy   User?   @relation("AssignmentDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([projectId, skillId])
  @@index([skillId, status])
  @@index([recommendedUserId])
  @@index([chosenUserId])
  @@index([decidedById])
}

/// "Reassignment suggested" (Phase 5 design 5): a signal for the founder,
/// never a silent change. Deduped per project, role, holder and suggestion.
model ReassignmentSuggestion {
  id          String    @id @default(cuid())
  projectId   String
  skillId     String
  fromUserId  String
  toUserId    String?
  reason      String
  /// "OPEN" | "ACCEPTED" | "DISMISSED"
  status      String    @default("OPEN")
  dedupeKey   String    @unique
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  from      User    @relation("ReassignFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to        User?   @relation("ReassignTo", fields: [toUserId], references: [id], onDelete: SetNull)
  decidedBy User?   @relation("ReassignDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@index([skillId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([decidedById])
}

// ---------------------------------------------------------------------------
// Phase 6 (Advertise X) — Client portal and client–team communication
// ---------------------------------------------------------------------------

/// An invitation to the client portal. Invite-only: the token is shown once
/// (and emailed when email is configured); only its SHA-256 is stored.
model ClientInvite {
  id              String    @id @default(cuid())
  organizationId  String
  clientAccountId String
  email           String
  name            String
  /// "OWNER" | "MEMBER"
  clientRole      String    @default("MEMBER")
  tokenHash       String    @unique
  invitedById     String?
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientAccount ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)
  invitedBy     User?         @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clientAccountId])
  @@index([invitedById])
  @@index([email])
}

/// A project update. "CLIENT" updates appear in the portal; "INTERNAL" ones
/// never do. The team chooses, explicitly, every time.
model ProjectUpdate {
  id         String   @id @default(cuid())
  projectId  String
  authorId   String?
  title      String
  body       String
  /// "INTERNAL" | "CLIENT"
  visibility String   @default("INTERNAL")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User?   @relation("ProjectUpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId, visibility, createdAt])
  @@index([authorId])
}

/// A report in the client's library ("Monthly Report — January"). The file
/// is the report; a DRAFT is the team's until it is published.
model ClientReport {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  title          String
  /// "MONTHLY" | "WEEKLY" | "CAMPAIGN" | "AUDIT" | "OTHER"
  kind           String    @default("MONTHLY")
  /// "YYYY-MM" — the month the report covers.
  periodMonth    String
  fileId         String    @unique
  /// "DRAFT" | "PUBLISHED"
  status         String    @default("DRAFT")
  publishedAt    DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  /// Phase 8 — generated by the monthly job (vs uploaded by hand).
  generated     Boolean   @default(false)
  /// "NONE" (uploaded) | "NEEDS_REVIEW" | "APPROVED" — a generated report is
  /// published only after a person has reviewed it.
  reviewState   String    @default("NONE")
  /// The narrative at the top of the report; `summarySource` says who wrote it:
  /// "AI" | "TEMPLATE" | "EDITED".
  summary       String?
  summarySource String?
  /// The report's figures as generated (JSON, modules/reports/domain.ts ·
  /// ReportData) — the in-app report renders from this, never from live data.
  data          String?
  reviewedById  String?
  reviewedAt    DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  file         File               @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdBy    User?              @relation("ReportUploader", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy   User?              @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reads        ClientReportRead[]

  @@index([organizationId])
  @@index([clientId, status, periodMonth])
  @@index([createdById])
  @@index([reviewedById])
  @@index([generated, reviewState])
}

/// Who has opened which report — the portal's unread indicator.
model ClientReportRead {
  reportId String
  userId   String
  readAt   DateTime @default(now())

  report ClientReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reportId, userId])
  @@index([userId])
}

/// A conversation with a client. "TEAM": the client and the team working for
/// them (permission-based). "FOUNDER": the private channel between the
/// client and the founders only.
model MessageThread {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  /// "TEAM" | "FOUNDER"
  kind           String   @default("TEAM")
  /// A TEAM thread may be about one project; null is the client's general thread.
  projectId      String?
  subject        String
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages     Message[]
  reads        ThreadRead[]

  @@index([organizationId])
  @@index([clientId, kind])
  @@index([projectId])
  @@index([lastMessageAt])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User?         @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  files  File[]

  @@index([threadId, createdAt])
  @@index([authorId])
}

/// How far each person has read a thread — unread counts and read receipts.
model ThreadRead {
  threadId   String
  userId     String
  lastReadAt DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
  @@index([userId])
}

/// The project's internal discussion thread.
model ProjectComment {
  id         String   @id @default(cuid())
  projectId  String
  authorId   String?
  body       String
  /// "INTERNAL" (the team's discussion) | "CLIENT" (shown in the portal).
  visibility String   @default("INTERNAL")
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User?   @relation("ProjectCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([authorId])
}

/// Which services a given engagement cycle covers. A join model rather than
/// an array column, so this ports to Postgres unchanged.
model ProjectService {
  projectId String
  serviceId String

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([projectId, serviceId])
  @@index([serviceId])
}

/// A workstream inside a project, e.g. "Google Ads" or "Weekly Reporting".
model Module {
  id        String   @id @default(cuid())
  projectId String
  name      String
  serviceId String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service    ServiceCatalog? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  milestones Milestone[]

  @@index([projectId])
}

/// A dated deliverable owned by one team member. The unit the scoring engine
/// reacts to.
model Milestone {
  id                 String    @id @default(cuid())
  moduleId           String
  title              String
  description        String?
  /// 1–5. Drives every scoring deduction in lib/scoring.ts.
  weight             Int       @default(3)
  /// Date-only, stored at UTC midnight. The effective deadline is the end of
  /// that day in Asia/Karachi — see dueDeadline() in lib/date.ts.
  dueDate            DateTime
  /// "PENDING" | "IN_PROGRESS" | "BLOCKED" | "SUBMITTED" | "COMPLETED" | "MISSED"
  status             String    @default("PENDING")
  /// When the member handed the work in. Phase 8: this — not completedAt — is
  /// what LATE and EARLY_BONUS are judged against, so the owner's review speed
  /// can never move a member's score. Cleared on rejection and stamped again
  /// on resubmission, so lateness always reflects the latest submission.
  submittedAt        DateTime?
  /// Set when an ADMIN approves. No longer feeds member scoring; it marks the
  /// work signed off and closes the review clock.
  completedAt        DateTime?
  /// Minutes from submission to the owner's decision on it. The owner's
  /// metric, not the member's, and shown only to the owner.
  adminReviewMinutes Int?
  /// Rough effort, in hours. Feeds the capacity bars shown wherever work is
  /// assigned, and the load line in the monthly report.
  estimatedHours     Int       @default(2)

  // --- Quality (Phase 10) --------------------------------------------------
  /// 1–5, set by the owner at approval. Punctuality was never the whole story:
  /// work can land on time and still be wrong.
  qualityRating  Int?
  /// Required when the rating is 2 or below — a low score the member cannot
  /// act on is just a number that makes them feel bad.
  qualityComment String?
  qualityRatedAt DateTime?

  // --- Carry-over (Phase 9) ------------------------------------------------
  /// True when the renewal job rolled this forward from a closed cycle.
  carriedOver   Boolean @default(false)
  /// The milestone in the previous cycle this one continues. Its MISSED
  /// penalty was already charged there and is never charged again here.
  carriedFromId String? @unique

  // --- Blocked clock (Phase 8) ---------------------------------------------
  /// "CLIENT" | "INTERNAL_DEPENDENCY" | "EXTERNAL" while blocked, else null.
  blockedReason       String?
  blockedNote         String?
  /// The milestone this one is waiting on; completing it auto-unblocks.
  blockingMilestoneId String?
  /// Start of the block currently running, null when not blocked.
  blockedSince        DateTime?
  /// Total minutes spent blocked. The sum of this milestone's BlockPeriod
  /// rows, cached here because scoring reads it on every evaluation.
  blockedMinutes      Int       @default(0)
  /// Status to return to when the block clears.
  statusBeforeBlock   String?

  assigneeId String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  module      Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  assignee    User?         @relation("MilestoneAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  scoreEvents ScoreEvent[]
  comments    Comment[]
  attachments Attachment[]
  activity    Activity[]
  blocks      BlockPeriod[]

  blockingMilestone Milestone?  @relation("MilestoneBlocker", fields: [blockingMilestoneId], references: [id], onDelete: SetNull)
  blockedDependents Milestone[] @relation("MilestoneBlocker")

  carriedFrom Milestone? @relation("MilestoneCarryOver", fields: [carriedFromId], references: [id], onDelete: SetNull)
  carriedInto Milestone? @relation("MilestoneCarryOver")

  @@index([moduleId])
  @@index([assigneeId, status])
  @@index([dueDate])
  @@index([status])
  @@index([blockingMilestoneId])
  @@index([status, submittedAt])
}

/// One period a milestone spent blocked.
///
/// The milestone carries a running total for scoring, but this is the record:
/// it is what attributes delay to a client rather than to the member, and it
/// survives the milestone being blocked and released repeatedly for different
/// reasons.
model BlockPeriod {
  id                  String    @id @default(cuid())
  milestoneId         String
  /// "CLIENT" | "INTERNAL_DEPENDENCY" | "EXTERNAL"
  reason              String
  note                String
  blockingMilestoneId String?
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  /// Filled when the period ends; null while it is still running.
  minutes             Int?
  createdById         String
  releasedById        String?
  /// True when the owner judged the block illegitimate. A vetoed period is
  /// kept but contributes no time to the effective deadline.
  vetoed              Boolean   @default(false)
  vetoNote            String?

  milestone  Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  createdBy  User      @relation("BlockAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  releasedBy User?     @relation("BlockReleaser", fields: [releasedById], references: [id], onDelete: SetNull)

  @@index([milestoneId])
  @@index([reason, startedAt])
}

// ---------------------------------------------------------------------------
// Phase 3 — Performance scoring
// ---------------------------------------------------------------------------

/// An immutable ledger entry. A member's monthly score is always derived as
/// 100 + sum(events for that month), clamped 0–100 — there is deliberately no
/// mutable score column anywhere in this schema.
model ScoreEvent {
  id          String   @id @default(cuid())
  userId      String
  milestoneId String?
  /// "LATE" | "MISSED" | "REJECTED" | "EARLY_BONUS" | "MANUAL_ADJUST"
  type        String
  /// Signed. Always a multiple of 0.5, which is exactly representable in
  /// binary floating point, so sums never drift.
  points      Float
  /// Required for every event; MANUAL_ADJUST refuses to save without one.
  reason      String
  /// Calendar month of the cycle this event scores against, in Asia/Karachi.
  year        Int
  month       Int
  /// Present for automatic events ("<milestoneId>:LATE") and null for the
  /// repeatable ones (REJECTED, MANUAL_ADJUST). The unique index is what makes
  /// re-running the evaluation job idempotent. Multiple NULLs are permitted by
  /// both SQLite and Postgres.
  dedupeKey   String?  @unique
  /// The admin behind a rejection or manual adjustment.
  createdById String?
  createdAt   DateTime @default(now())

  user      User       @relation("ScoreEventSubject", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User?      @relation("ScoreEventAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  dispute   Dispute?

  @@index([userId, year, month])
  @@index([type])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Phase 4 — Automated reporting and notifications
// ---------------------------------------------------------------------------

/// A generated report.
///
/// The `payload` is a frozen snapshot taken at generation time. A report is a
/// statement about a period that has closed, so it must never change when the
/// underlying data does — reopening a milestone months later cannot be allowed
/// to rewrite what August's report said.
model Report {
  id          String   @id @default(cuid())
  /// "MEMBER_WEEKLY" | "MEMBER_MONTHLY" | "CLIENT_WEEKLY"
  type        String
  periodStart DateTime
  periodEnd   DateTime
  /// Set for member reports.
  userId      String?
  /// Set for client reports.
  clientId    String?
  generatedAt DateTime @default(now())
  /// Serialized JSON. Stored as text rather than a Json column: SQLite has no
  /// native Json type, and keeping this portable is the standing rule here.
  /// lib/reports.ts owns the parse and the version field inside it.
  payload     String
  /// "<type>:<periodStart>:<subjectId>". A unique index on it is what makes
  /// regeneration idempotent — the same period cannot produce two reports.
  dedupeKey   String   @unique

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([type, periodStart])
  @@index([userId, type])
  @@index([clientId, type])
}

// ---------------------------------------------------------------------------
// Phase 5 — Collaboration on a milestone
// ---------------------------------------------------------------------------

/// A comment on a milestone. One level of threading: a reply points at the
/// comment it answers, and replies of replies are flattened into the same
/// thread — deep nesting turns a work discussion into a maze.
model Comment {
  id          String   @id @default(cuid())
  milestoneId String
  userId      String
  body        String
  /// Null for a top-level comment; otherwise the comment being replied to.
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  milestone Milestone        @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Comment?         @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]        @relation("CommentThread")
  mentions  CommentMention[]

  @@index([milestoneId, createdAt])
  @@index([parentId])
}

/// Who a comment mentioned. Stored rather than re-parsed, so renaming someone
/// can never silently change who was notified about what.
model CommentMention {
  id        String @id @default(cuid())
  commentId String
  userId    String

  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
}

/// An uploaded file.
///
/// `storedName` is server-generated and is the only thing ever used to build a
/// path; `filename` is the untrusted original, kept for display only.
model Attachment {
  id          String   @id @default(cuid())
  milestoneId String
  uploaderId  String
  /// Original name, shown to people. Never used for filesystem access.
  filename    String
  /// Generated name on disk, e.g. "<cuid>.png".
  storedName  String   @unique
  mimeType    String
  /// Bytes.
  size        Int
  createdAt   DateTime @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  uploader  User      @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([milestoneId, createdAt])
}

/// The audit trail: what happened, to what, and who did it.
///
/// Written by the routes that change things rather than by database triggers,
/// so each entry can carry a sentence a person can actually read.
model Activity {
  id          String   @id @default(cuid())
  /// "STATUS_CHANGED" | "REASSIGNED" | "DUE_DATE_CHANGED" | "SCORE_EVENT"
  /// | "COMMENT_ADDED" | "ATTACHMENT_ADDED" | "MILESTONE_CREATED"
  type        String
  /// Pre-rendered, e.g. "moved Campaign launch to Submitted".
  summary     String
  /// Optional extra detail — a rejection reason, the old and new date.
  detail      String?
  milestoneId String?
  /// Null for anything the system did on its own (the evaluation pass).
  actorId     String?
  createdAt   DateTime @default(now())

  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  actor     User?      @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([milestoneId, createdAt])
}

/// An in-app notification. No email yet — that's a later phase.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// "TASK_ASSIGNED" | "DUE_TOMORROW" | "OVERDUE" | "WORK_APPROVED"
  /// | "WORK_REJECTED" | "REPORT_READY"
  type      String
  title     String
  body      String
  /// Where clicking it should take them.
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  milestoneId String?
  reportId    String?

  /// Present for the ones a repeated job could otherwise duplicate
  /// (due-tomorrow, overdue, report-ready); null for one-off events.
  dedupeKey String? @unique

  /// Phase 8 — the email channel: null (not wanted), "PENDING", "SENT",
  /// "SKIPPED" (email not configured) or "FAILED" (retried by the morning job).
  emailState String?
  emailedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([emailState])
}

// ---------------------------------------------------------------------------
// Phase 7 — Attendance
// ---------------------------------------------------------------------------

/// One person's working day.
///
/// `date` is the Asia/Karachi calendar date stored at UTC midnight, the same
/// convention as every other date-only field here. All attendance arithmetic
/// resolves to Karachi wall-clock regardless of where the member's device is.
model AttendanceDay {
  id           String    @id @default(cuid())
  userId       String
  date         DateTime
  clockInAt    DateTime?
  clockOutAt   DateTime?
  /// "PRESENT" | "LATE" | "ABSENT" | "LEAVE" | "OFF"
  status       String    @default("PRESENT")
  /// Minutes between clock-in and clock-out, once the day is closed.
  totalMinutes Int?
  /// True when the evaluation job closed the day because nobody clocked out.
  autoClosed   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  checks AvailabilityCheck[]

  @@unique([userId, date])
  @@index([date])
  @@index([userId, date])
}

/// A hidden, randomly scheduled proof-of-availability.
///
/// `scheduledAt` is the secret. It is generated server-side at clock-in and
/// must never reach a member's browser before it triggers — see
/// lib/attendance-visibility.ts, which is the single place that decides what a
/// member is allowed to see.
model AvailabilityCheck {
  id              String    @id @default(cuid())
  attendanceDayId String
  scheduledAt     DateTime
  /// scheduledAt + the configured window (60 minutes by default).
  windowEndsAt    DateTime
  respondedAt     DateTime?
  /// "SCHEDULED" | "ACTIVE" | "PASSED" | "MISSED" | "CANCELLED"
  /// | "PENDING_REVIEW" (an outage report covers it) | "EXCUSED" (upheld)
  status          String    @default("SCHEDULED")
  /// The outage report that put this check under review.
  outageReportId  String?
  /// How many times a break pushed this check later in the day. Kept so the
  /// owner can see a member whose breaks keep landing on their checks.
  deferrals       Int       @default(0)
  createdAt       DateTime  @default(now())

  day    AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)
  outage OutageReport? @relation(fields: [outageReportId], references: [id], onDelete: SetNull)

  @@index([attendanceDayId])
  @@index([status, scheduledAt])
  @@index([status, windowEndsAt])
  @@index([outageReportId])
}

/// A member declaring time they were unreachable through no fault of theirs.
///
/// Load-shedding and dropped links are facts of remote work in Karachi, so a
/// missed check that overlaps a declared outage does not charge automatically —
/// it waits for the owner's judgement.
model OutageReport {
  id           String    @id @default(cuid())
  userId       String
  /// "POWER" | "INTERNET"
  type         String
  startsAt     DateTime
  endsAt       DateTime
  note         String
  /// "PENDING" | "APPROVED" | "REJECTED"
  status       String    @default("PENDING")
  /// True when the report was filed after a covered check had already expired.
  /// Not a judgement — an outage stops you filing too — but the owner sees it.
  filedLate    Boolean   @default(false)
  reviewedById String?
  reviewedAt   DateTime?
  adminNote    String?
  createdAt    DateTime  @default(now())

  user       User                @relation("OutageSubject", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?               @relation("OutageReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  checks     AvailabilityCheck[]

  @@index([userId, startsAt])
  @@index([status, createdAt])
}

/// Protected time inside the shift: prayer, a meal, or a short personal break.
///
/// Never penalized within the daily allowance. While one is open no check
/// activates and none can expire, so a break can never cost points.
model BreakSession {
  id         String    @id @default(cuid())
  userId     String
  /// Karachi day at UTC midnight, so a day's allowance is one query.
  date       DateTime
  /// "PRAYER" | "MEAL" | "PERSONAL"
  reason     String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  minutes    Int?
  /// True when the daily job closed a break the member left running.
  autoClosed Boolean   @default(false)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, endedAt])
}

// ---------------------------------------------------------------------------
// Phase 9 — Sales pipeline
// ---------------------------------------------------------------------------

/// A prospect, before they are a Client.
///
/// Kept separate from Client rather than modelled as another Client status:
/// a lead has a stage, an owner, an estimated value and an activity history,
/// none of which a signed client has, and a signed client has projects and
/// milestones a lead must never accidentally acquire. Winning one converts.
model Lead {
  id                    String    @id @default(cuid())
  /// The business line this deal belongs to. Also decides which PipelineStage
  /// rows are valid for `stage`.
  departmentId          String
  businessName          String
  contactName           String
  email                 String?
  phone                 String?
  /// "OUTREACH" | "REFERRAL" | "INBOUND" | "SOCIAL"
  source                String    @default("OUTREACH")
  /// Free text when the source is OTHER (or refines any source), e.g. "Food expo 2026".
  sourceDetail          String?
  country               String?
  /// City / neighbourhood — where the business trades.
  location              String?
  website               String?
  /// Restaurant / food segment, e.g. "Restaurant", "Café", "Ghost kitchen".
  industry              String?
  /// Comma-separated, lower-case; parsed only by modules/leads/domain.ts.
  tags                  String    @default("")
  /// ServiceCatalog slugs, comma-separated. Slugs rather than ids so a lead
  /// survives the catalogue being re-seeded, and comma-separated rather than
  /// an array column so this ports to Postgres unchanged.
  interestedServices    String    @default("")
  /// Whole currency units per month, matching Client.monthlyBudget.
  estimatedMonthlyValue Int       @default(0)
  /// What this deal is worth — a Pilot Cars quote, an insurance premium, an
  /// affiliate's expected volume. Whole currency units, like every other money
  /// column here. Optional per department: a business line that does not price
  /// at the lead stage leaves it at zero.
  dealValue             Int       @default(0)
  ownerId               String?
  /// Who filed the lead. Kept apart from the owner because automatic routing
  /// hands most leads to someone else, and the person who entered a lead must
  /// still be able to correct what they typed. Null for leads filed before the
  /// column existed.
  createdById           String?
  /// "NEW" | "CONTACTED" | "MEETING_BOOKED" | "PROPOSAL_SENT" | "NEGOTIATION"
  /// | "WON" | "LOST"
  stage                 String    @default("NEW")
  /// When the stage last changed — drives "sitting in NEGOTIATION for 3 weeks".
  stageChangedAt        DateTime  @default(now())
  /// Required when the stage is LOST. The reason is the point of recording it.
  lostReason            String?
  lostNote              String?
  notes                 String?
  /// The next thing owed to this deal. Core, not dynamic: every department
  /// works a follow-up queue off it.
  nextFollowUpAt        DateTime?
  /// Set when the lead is converted, so a won deal can't be converted twice.
  convertedClientId     String?   @unique
  convertedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  department      Department       @relation(fields: [departmentId], references: [id])
  owner           User?            @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)
  convertedClient Client?          @relation(fields: [convertedClientId], references: [id], onDelete: SetNull)
  activities      SalesActivity[]
  tasks           Task[]
  stageEvents     LeadStageEvent[]

  @@index([departmentId, stage])
  @@index([createdAt])
  @@index([source])
  @@index([nextFollowUpAt])
  @@index([stage, stageChangedAt])
  @@index([ownerId, stage])
}

/// One recorded piece of sales work. The unit activity targets count.
model SalesActivity {
  id           String   @id @default(cuid())
  departmentId String
  /// Exactly one of these is set. Two nullable foreign keys rather than a bare
  /// polymorphic `recordId`: there are only two possible targets and both are
  /// known when the row is written, so the database can still cascade a delete
  /// and refuse an orphan. FieldValue gives that up only because its target
  /// table is decided by another column, which Prisma cannot express.
  leadId       String?
  clientId     String?
  userId       String
  /// One of ACTIVITY_TYPES in lib/constants.ts.
  type         String
  note         String
  /// True when the app wrote this rather than a person — a stage move, a
  /// reassignment. Kept apart so the timeline can distinguish what somebody did
  /// from what merely happened.
  isSystem     Boolean  @default(false)
  occurredAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  lead       Lead?      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client     Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([leadId, occurredAt])
  @@index([clientId, occurredAt])
  @@index([departmentId, occurredAt])
}

/// A piece of follow-up work on a lead or a client.
///
/// Deliberately not `Milestone`, which is retainer delivery inside a parked
/// module: a milestone is a scheduled deliverable on a monthly plan, a task is
/// "ring them back on Thursday". Sharing one table would tie the CRM's daily
/// working surface to a module CLAUDE.md says is switched off.
model Task {
  id           String    @id @default(cuid())
  departmentId String
  /// Exactly one, for the same reason as SalesActivity above.
  leadId       String?
  clientId     String?
  title        String
  note         String?
  assigneeId   String?
  createdById  String?
  dueAt        DateTime?
  /// One of TASK_PRIORITIES in lib/constants.ts.
  priority     String    @default("MEDIUM")
  /// "NOT_STARTED" | "IN_PROGRESS" | "REVIEW" | "COMPLETED" — see
  /// modules/tasks/domain.ts. Rows written before Phase 2 may hold "OPEN" or
  /// "DONE"; every read normalizes them (ADR-011).
  status       String    @default("NOT_STARTED")
  /// Optional until projects are attached to tasks in Phase 4.
  projectId    String?
  completedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  lead       Lead?               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  client     Client?             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignee   User?               @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy  User?               @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  project    Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  checklist  TaskChecklistItem[]
  comments   TaskComment[]
  files      File[]

  @@index([assigneeId, status, dueAt])
  @@index([projectId])
  @@index([departmentId, status])
  @@index([leadId])
  @@index([clientId])
}

/// A standing weekly activity target for one person.
///
/// Buckets rather than raw activity types — "40 outreach" means calls, emails
/// and DMs together, and counting each separately would be a target nobody
/// could reason about. See ACTIVITY_BUCKET in lib/pipeline-types.ts.
model ActivityTarget {
  id           String   @id @default(cuid())
  userId       String
  /// "OUTREACH" | "FOLLOW_UP" | "PROPOSAL" | "MEETING"
  bucket       String
  weeklyTarget Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bucket])
  @@index([userId, isActive])
}

/// One week of a client's commercial numbers.
///
/// Entered by hand in v1, by whoever runs the ads — see lib/integrations/ for
/// how the Google and Meta APIs would replace the typing later.
///
/// ROAS and conversion rate are deliberately **not stored**. They are ratios
/// of the columns beside them, and a stored ratio is a number that can
/// disagree with its own inputs the moment one is corrected.
model ClientKpiEntry {
  id            String   @id @default(cuid())
  clientId      String
  /// Monday of the week, at UTC midnight. One entry per client per week.
  weekStart     DateTime
  /// Whole currency units, like every other money column here.
  googleSpend   Int      @default(0)
  metaSpend     Int      @default(0)
  revenue       Int      @default(0)
  orders        Int      @default(0)
  storeSessions Int      @default(0)
  notes         String?
  enteredById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  enteredBy User?  @relation("KpiAuthor", fields: [enteredById], references: [id], onDelete: SetNull)

  @@unique([clientId, weekStart])
  @@index([clientId, weekStart])
}

/// Monthly recurring revenue, captured once a month.
///
/// MRR is derivable from today's clients but its history is not: a client that
/// churns in March takes February's number with it. The nightly job snapshots
/// the figure so the trend line is a record rather than a reconstruction.
model MrrSnapshot {
  id            String   @id @default(cuid())
  year          Int
  month         Int
  /// Whole currency units.
  amount        Int
  activeClients Int
  capturedAt    DateTime @default(now())

  @@unique([year, month])
  @@index([year, month])
}

/// A browser push endpoint. One row per device, so a member on a phone and a
/// laptop is reached on both.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A member's request to be off on a given day.
model LeaveRequest {
  id           String    @id @default(cuid())
  userId       String
  date         DateTime
  reason       String
  /// "PENDING" | "APPROVED" | "REJECTED"
  status       String    @default("PENDING")
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  user       User  @relation("LeaveSubject", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  /// One request per person per day — a second would make "is this day
  /// approved?" ambiguous.
  @@unique([userId, date])
  @@index([status, date])
}

/// Agency-wide configuration, editable by the owner without a deploy.
///
/// A single row rather than a key/value table: these settings are a fixed,
/// known set, and typed columns mean a bad value fails at the database rather
/// than at whatever code parses the string.
model Settings {
  /// Always "singleton".
  id String @id @default("singleton")

  /// Minutes past Karachi midnight.
  shiftStartMinutes   Int @default(720) // 12:00
  shiftEndMinutes     Int @default(1320) // 22:00
  clockInOpensMinutes Int @default(690) // 11:30
  /// Clock-in later than shiftStart + grace counts as LATE.
  graceMinutes        Int @default(15)
  /// No clock-in by this time and no approved leave means ABSENT.
  absentCutoffMinutes Int @default(900) // 15:00

  checksPerDay               Int @default(3)
  checkWindowMinutes         Int @default(60)
  /// Earliest a check may fall, measured from clock-in.
  checkEarliestOffsetMinutes Int @default(45)
  /// Latest a check may be scheduled, so its window still ends by shift end.
  checkLatestMinutes         Int @default(1260) // 21:00
  checkMinGapMinutes         Int @default(90)

  /// Penalties, stored positive and applied as deductions.
  penaltyLateClockIn Float @default(0.5)
  penaltyAbsentDay   Float @default(3)
  penaltyMissedCheck Float @default(1)

  /// Working days as ISO weekday numbers, 1 = Monday. Sunday (7) is off.
  workdays String @default("1,2,3,4,5,6")

  // --- Fairness settings (Phase 8) -----------------------------------------
  /// Protected prayer/meal/personal minutes per day. Never penalized.
  breakAllowanceMinutes Int @default(90)
  /// How many outage reports a member may file per calendar month.
  outageReportsPerMonth Int @default(4)
  /// Longest single outage a member may declare, in hours.
  outageMaxHours        Int @default(4)
  /// Hours the owner has to review submitted work before it is flagged.
  reviewSlaHours        Int @default(48)

  // --- Pipeline scoring (Phase 9) ------------------------------------------
  /// Points for a closed deal, and for each weekly activity target met.
  bonusDealWon        Float @default(3)
  bonusTargetMet      Float @default(1)
  /// Charged when a target finishes below `targetMissThreshold` of its number.
  penaltyTargetMissed Float @default(1)
  /// Share of a target below which the week counts as missed. 0.6 = 60%.
  targetMissThreshold Float @default(0.6)

  // --- Auto-renewal (Phase 9) ----------------------------------------------
  /// Master switch. Individual clients can still opt out.
  autoRenewEnabled Boolean @default(true)
  /// Days into the new cycle that carried-over work is re-dated to.
  carryOverDueDays Int     @default(5)

  // --- Quality, money and health (Phase 10) --------------------------------
  /// Points for five-star work, and off for two stars or below.
  bonusQualityHigh   Float @default(0.5)
  penaltyQualityLow  Float @default(1)
  /// Agency-wide ROAS target, used when a client has none of their own.
  defaultTargetRoas  Float @default(3)
  /// Consecutive weeks under target before the alert fires.
  roasAlertWeeks     Int   @default(2)
  /// Days after a cycle starts before an unpaid invoice is called overdue.
  paymentOverdueDays Int   @default(7)

  /// Client health weights, as whole percentages that should sum to 100.
  /// lib/clientHealth.ts normalises defensively either way.
  healthWeightDelivery Int @default(35)
  healthWeightRoas     Int @default(30)
  healthWeightPayment  Int @default(20)
  healthWeightBlocked  Int @default(15)

  // --- Delegation, incentives and culture (Phase 11) -----------------------
  /// Hours a submission waits for its Service Lead before the owner is pulled
  /// in as well. Delegation must not become a place work goes to die.
  leadEscalationHours Int @default(24)

  /// Score at or above which a month counts towards the excellence streak,
  /// and how many consecutive months earn it.
  bonusThresholdScore Int   @default(90)
  bonusStreakMonths   Int   @default(3)
  /// Payroll reference only — this app never moves money.
  defaultBonusPercent Float @default(10)

  /// Score below which a month counts towards a review, how many of the last
  /// N months trigger one.
  reviewThresholdScore Int @default(60)
  reviewWindowMonths   Int @default(3)
  reviewTriggerCount   Int @default(2)

  /// How long a member has to dispute an event, and how long the owner has to
  /// answer.
  disputeWindowDays Int @default(7)
  disputeSlaHours   Int @default(72)

  /// "ADMIN_ONLY" | "TEAM_VISIBLE". Default is deliberately private: ranking
  /// five people against each other is a different product.
  leaderboardVisibility String @default("ADMIN_ONLY")

  /// Hours since the last successful backup before the owner is warned.
  backupWarnHours Int @default(26)

  // --- Advertise X fork: company settings ------------------------------------------
  /// IANA timezone the whole app reasons in: due dates, "today", the boundary
  /// of a day. A setting rather than a constant because the fork inherited
  /// Asia/Karachi and Advertise X operates US-based.
  timezone String @default("America/New_York")

  // --- Automatic routing ----------------------------------------------------
  /// Whether a record filed without an assignee is routed to the department
  /// member whose skills or job title name the work, falling back to whoever
  /// is carrying the least. Off means the old behaviour: the record stays with
  /// whoever created it.
  ///
  /// A setting rather than a constant because the right answer differs by
  /// business line — a sales desk may want every enquiry to stay with the
  /// person who took it — and because a routing rule nobody can switch off is
  /// a routing rule nobody trusts.
  autoAssignEnabled Boolean @default(true)

  // --- Project assignment (Advertise X Phase 5) ------------------------------
  /// "RECOMMEND" (the founder confirms) | "AUTO" (assign on creation).
  assignmentMode      String @default("RECOMMEND")
  /// JSON weights {skillMatch, availability, capacity, performance, deadlineFit}.
  assignmentWeights   String @default("{\"skillMatch\":40,\"availability\":10,\"capacity\":20,\"performance\":20,\"deadlineFit\":10}")
  /// Weekly hours a project role is expected to take.
  assignmentRoleHours Int    @default(6)

  // --- Advertise X fork: parked module flags ---------------------------------------
  /// Modules inherited from the agency fork that Advertise X did not request. All
  /// default off, and off means the feature *disappears* — no nav item, no
  /// dashboard card, no cron run, no reachable route — rather than rendering
  /// an empty panel. The code stays so a flag can switch it back on.
  featureAttendance     Boolean @default(false)
  featureScoring        Boolean @default(false)
  featureRetainerCycles Boolean @default(false)
  featureClientKpis     Boolean @default(false)

  updatedAt DateTime @updatedAt
}

/// A page or route that blew up, captured where it happened.
///
/// Before this table existed, a broken page was discovered by a team member
/// mentioning it in chat — by which time the stack trace was long gone and the
/// only way back to the cause was guesswork. Writing the error down at the
/// moment it happens is the difference between "/clients is broken" and a file
/// and line number.
///
/// Writes are fire-and-forget: logging an error must never be able to cause
/// one. Nothing here is user input, so it is safe to show the owner verbatim.
model SystemError {
  id String @id @default(cuid())

  /// Path that failed, e.g. "/clients" or "/api/milestones/[id]/status".
  route   String
  message String
  stack   String?
  /// Next's error digest, which is the only handle the browser gets in
  /// production — it is what ties a user's report to the row.
  digest  String?

  /// Who hit it. Denormalised on purpose: the row must survive the user being
  /// deleted, and it is evidence, not a relation to keep in step.
  userId   String?
  userRole String?

  /// Set when the owner has seen it, so the sidebar badge counts what is new.
  seenAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([seenAt])
}

// ---------------------------------------------------------------------------
// Advertise X fork — departments
//
// A department is a business line. Advertise X seeds four, but nothing in the schema,
// a constant or a component may assume that number or those names: departments
// are records an admin edits, and the seed is Advertise X's starting shape rather than
// the system's definition.
// ---------------------------------------------------------------------------

model Department {
  id             String  @id @default(cuid())
  /// Nullable only for rows that predate tenancy; backfilled by the seed.
  organizationId String?
  /// Stable machine key, e.g. "pilot-cars". Referenced by seeds, imports and
  /// URLs, so it survives the display name being reworded.
  slug           String  @unique
  name           String
  /// Compact name for badges, pills and narrow table columns, where the full
  /// "Paid Ads — 90-Day Growth Sprint" will not fit.
  shortLabel     String
  /// Semantic token name from theme (e.g. "brand", "info"), never a raw hex.
  /// Null renders the neutral tone, so a department without a colour is a
  /// normal state rather than a broken badge.
  colorToken     String?
  description    String?
  /// Order in nav, dropdowns and dashboards. Admin-draggable.
  order          Int     @default(0)
  /// Deactivating hides a department without deleting its history. Rows keep
  /// pointing at it, so nothing orphans.
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  DepartmentMembership[]
  stages       PipelineStage[]
  fields       FieldDefinition[]
  clients      Client[]
  leads        Lead[]
  organization Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  activities   SalesActivity[]
  tasks        Task[]

  @@index([isActive, order])
  @@index([organizationId])
}

/// Which departments a person works in, and what they do there.
///
/// This is the team-department-skill mapping the doctrine requires to be data.
/// ADMIN and SUPPORT_ADMIN see every department regardless of these rows; they
/// exist to scope a MEMBER.
model DepartmentMembership {
  id           String @id @default(cuid())
  userId       String
  departmentId String
  /// "LEAD" | "MEMBER" — see DEPT_ROLES in lib/constants.ts. A department lead
  /// runs that business line; it is scoping and display, not a global role.
  roleInDept   String @default("MEMBER")
  /// Skills inside this department, comma-separated and free text.
  ///
  /// Not a String[]: SQLite has no array column and the schema is kept
  /// Postgres-portable, so this follows the same comma-separated convention as
  /// Lead.interestedServices. Always read and written through
  /// parseSkills()/serializeSkills() in lib/skills.ts, which own the trimming
  /// and de-duplication — nothing should split this string by hand.
  skills       String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([departmentId])
}

/// One stage of one department's pipeline.
///
/// Departments sell different things and do not share a funnel: dispatch
/// scheduling and insurance qualification have no stage in common. Stages are
/// therefore per-department records rather than a shared union in code.
model PipelineStage {
  id           String  @id @default(cuid())
  departmentId String
  /// Stable machine key, unique within the department.
  key          String
  label        String
  sortOrder    Int     @default(0)
  /// One of STAGE_KINDS in lib/constants.ts: OPEN | WON | LOST | ACTIVE_CLIENT.
  ///
  /// Replaces the isWon/isLost pair. Two booleans could express "won and lost
  /// at once", which is not a state a deal can be in, and left nowhere to put
  /// the ACTIVE_CLIENT stages that sit *after* a win. The app reads this rather
  /// than string-matching "WON", because stage keys are admin-editable.
  kind         String  @default("OPEN")
  /// A DEPARTMENT_COLOR_TOKENS value, tinting this column on the board.
  colorToken   String?
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, key])
  @@index([departmentId, sortOrder])
}

/// A department-specific field on a lead or a client.
///
/// The four departments sell different things and record different facts:
/// dispatch needs pickup and destination, insurance needs policy type and
/// coverage, affiliates need commission terms. Widening Client and Lead with
/// every department's columns would give each department a table full of other
/// people's nulls, so each declares its own fields and the answers live in
/// FieldValue.
///
/// What stays a real column on the record is the common core every department
/// shares — name, email, phone, department, assignee, stage, source, created,
/// next follow-up. Those are queried, sorted and filtered constantly, and a
/// join per column would be a tax on every list in the product.
model FieldDefinition {
  id           String  @id @default(cuid())
  departmentId String
  /// "LEAD" | "CLIENT" — see FIELD_ENTITIES in lib/constants.ts. A department
  /// can want a fact on a deal that it does not want on a converted client.
  entity       String
  /// Stable machine key, unique per department and entity.
  key          String
  label        String
  /// One of FIELD_TYPES in lib/constants.ts. Decides the input rendered, the
  /// validation applied, and how the stored string is parsed back.
  type         String  @default("TEXT")
  /// Options for SELECT and MULTISELECT, comma-separated.
  ///
  /// Not a String[]: SQLite has no array column and the schema is kept
  /// Postgres-portable. Read and written through parseOptions()/
  /// serializeOptions() in lib/fields.ts — nothing splits this by hand.
  options      String  @default("")
  helpText     String?
  required     Boolean @default(false)
  order        Int     @default(0)
  isActive     Boolean @default(true)

  /// Conditional visibility: show this field only when the field with
  /// `showIfKey` holds one of `showIfValues` (comma-separated).
  ///
  /// Culture Plus needs this — its insurance questions are irrelevant to a Cam
  /// sale and vice versa, and asking every question of every lead is how a form
  /// stops being filled in honestly. Null means always visible.
  showIfKey    String?
  showIfValues String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  values     FieldValue[]

  @@unique([departmentId, entity, key])
  @@index([departmentId, entity, order])
}

/// One record's answer to one field definition.
///
/// `recordId` is the Lead or Client id. Deliberately not a foreign key: the
/// definition's `entity` says which table it points at, and Prisma cannot
/// express a relation whose target depends on another column. Deleting a record
/// therefore has to clear its values explicitly — `deleteFieldValues()` in
/// lib/fields.ts owns that, and is called from every delete path.
///
/// Stored as text whatever the declared type, with lib/fields.ts owning the
/// parsing. A Json column would be the obvious alternative, but SQLite has none
/// and the schema is kept Postgres-portable; text plus a typed accessor also
/// means changing a field from TEXT to SELECT is not a column migration.
model FieldValue {
  id                String @id @default(cuid())
  fieldDefinitionId String
  recordId          String
  value             String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  definition FieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([fieldDefinitionId, recordId])
  @@index([recordId])
}

// ---------------------------------------------------------------------------
// Phase 7 (Advertise X) — invoices and payments
//
// Money is integer minor units (cents) everywhere in this section, never a
// float. Rounding rules: docs/METRICS.md → "Money".
// ---------------------------------------------------------------------------

/// An invoice to a client. Editable only as a DRAFT; sending it takes the
/// organization's next number and freezes who it is billed to.
model Invoice {
  id                String    @id @default(cuid())
  organizationId    String
  clientId          String
  projectId         String?
  /// Null while a draft; unique per organization once sent.
  number            Int?
  /// The printed number, e.g. "INV-0007", fixed when sent.
  numberLabel       String?
  currency          String
  /// "DRAFT" | "SENT" | "PARTIALLY_PAID" | "PAID" | "OVERDUE" | "VOID"
  status            String    @default("DRAFT")
  issueDate         DateTime?
  dueDate           DateTime
  notes             String?
  subtotalMinor     Int       @default(0)
  totalMinor        Int       @default(0)
  /// Σ of this invoice's payments that aren't reversed. Kept in step inside
  /// the same transaction as every payment change.
  paidMinor         Int       @default(0)
  /// Who it is billed to, copied from the client when sent.
  billToName        String?
  billToEmail       String?
  billToAddress     String?
  sentAt            DateTime?
  paidAt            DateTime?
  voidedAt          DateTime?
  voidReason        String?
  overdueNotifiedAt DateTime?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines        InvoiceLine[]
  payments     Payment[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([clientId, status])
  @@index([projectId])
  @@index([dueDate])
  @@index([issueDate])
  @@index([createdById])
}

/// One line: quantity × rate = amount (rounded half away from zero).
model InvoiceLine {
  id            String  @id @default(cuid())
  invoiceId     String
  serviceId     String?
  description   String
  /// Thousandths: 1.5 hours is 1500.
  quantityMilli Int
  rateMinor     Int
  amountMinor   Int
  position      Int     @default(0)

  invoice Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service ServiceCatalog? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([invoiceId, position])
  @@index([serviceId])
}

/// Money received against an invoice. Never edited or deleted: a mistake is
/// reversed (kept, with who and why), so the history stays whole.
model Payment {
  id             String    @id @default(cuid())
  organizationId String
  invoiceId      String
  amountMinor    Int
  currency       String
  /// "BANK_TRANSFER" | "CARD" | "CASH" | "CHECK" | "OTHER"
  method         String
  paidAt         DateTime
  reference      String?
  /// Unique per organization: a retried request records the payment once.
  idempotencyKey String
  /// "MANUAL" | "STRIPE"
  source         String    @default("MANUAL")
  providerRef    String?
  recordedById   String?
  reversedAt     DateTime?
  reversedById   String?
  reverseReason  String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy   User?        @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  reversedBy   User?        @relation("PaymentReverser", fields: [reversedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([invoiceId])
  @@index([organizationId, paidAt])
  @@index([recordedById])
  @@index([reversedById])
}

// ---------------------------------------------------------------------------
// Phase 8 (Advertise X) — analytics, client metrics, announcements
// ---------------------------------------------------------------------------

/// A founder announcement to everyone, the team, or clients. Delivered as a
/// notification to each recipient (in-app, and email per their preferences).
model Announcement {
  id             String   @id @default(cuid())
  organizationId String
  authorId       String?
  title          String
  body           String
  /// "EVERYONE" | "TEAM" | "CLIENTS"
  audience       String
  recipients     Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([authorId])
}

/// One client metric for one period (monthly now), from one source. Integer,
/// scaled by the metric's unit (modules/client-analytics/metrics.ts): money
/// in minor units, counts as-is, ratios in thousandths. Rates (CTR, CPA, ROAS…)
/// are derived, never stored.
model MetricValue {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  /// "MANUAL" | "MOCK" | "GOOGLE_ADS" | "META_ADS" | "GA4" | "SEARCH_CONSOLE" | "GOOGLE_BUSINESS_PROFILE"
  source         String
  metricKey      String
  /// "MONTH" (DAY reserved for live syncs)
  granularity    String    @default("MONTH")
  /// UTC midnight of the period's first day.
  periodStart    DateTime
  value          Int
  enteredById    String?
  syncedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  enteredBy    User?        @relation(fields: [enteredById], references: [id], onDelete: SetNull)

  @@unique([clientId, metricKey, source, granularity, periodStart])
  @@index([organizationId, periodStart])
  @@index([clientId, periodStart])
  @@index([enteredById])
}

/// A client's link to a data provider (one per client per provider).
model IntegrationConnection {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  /// "GOOGLE_ADS" | "META_ADS" | "GA4" | "SEARCH_CONSOLE" | "GOOGLE_BUSINESS_PROFILE"
  provider       String
  /// "NOT_CONNECTED" | "MOCK" | "CONNECTED" | "ERROR"
  status         String    @default("NOT_CONNECTED")
  accountLabel   String?
  lastSyncedAt   DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, provider])
  @@index([organizationId])
}

/// A computed analytics payload, cached (the Command Center's "materialized
/// where needed"). Recomputed when older than its TTL; warmed each morning.
model AnalyticsSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  payload        String
  computedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}
