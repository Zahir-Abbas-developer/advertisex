{
  "name": "advertisex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-db-provider.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-db-provider.mjs && prisma generate",
    "build": "next build",
    "vercel-build": "node scripts/sync-db-provider.mjs && prisma generate && PRISMA_SCHEMA_DISABLE_ADVISORY_LOCK=true DATABASE_URL=\"${DATABASE_URL_UNPOOLED:-$DATABASE_URL}\" node scripts/migrate-deploy.mjs && DATABASE_URL=\"${DATABASE_URL_UNPOOLED:-$DATABASE_URL}\" tsx prisma/seed.ts && next build",
    "start": "next start",
    "share": "node scripts/share.mjs",
    "set-passwords": "node scripts/set-passwords.mjs",
    "lint": "eslint . --ext .ts,.tsx,.js,.mjs --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:provider": "node scripts/sync-db-provider.mjs",
    "db:push": "node scripts/sync-db-provider.mjs && prisma db push",
    "db:migrate": "node scripts/sync-db-provider.mjs && prisma migrate dev",
    "db:deploy": "node scripts/sync-db-provider.mjs && node scripts/migrate-deploy.mjs",
    "db:seed": "node scripts/sync-db-provider.mjs && tsx prisma/seed.ts && tsx prisma/seed-demo.ts",
    "db:seed:admin": "node scripts/sync-db-provider.mjs && tsx prisma/seed-admin.ts",
    "promote": "node scripts/sync-db-provider.mjs && node scripts/promote-admin.mjs",
    "db:studio": "prisma studio",
    "db:reset": "node scripts/sync-db-provider.mjs && prisma db push --force-reset && npm run db:seed",
    "smoke": "node scripts/sync-db-provider.mjs && node --import tsx scripts/smoke.mjs",
    "smoke:empty": "node scripts/sync-db-provider.mjs && node --import tsx scripts/smoke.mjs --empty",
    "smoke:browser": "node --import tsx scripts/smoke-browser.mjs",
    "leaks": "node scripts/sync-db-provider.mjs && node --import tsx scripts/leak-scan.mjs",
    "permtest": "node scripts/sync-db-provider.mjs && node --import tsx scripts/permtest.mjs",
    "fieldtest": "node scripts/sync-db-provider.mjs && node --import tsx scripts/fieldtest.mjs",
    "journeytest": "node scripts/sync-db-provider.mjs && node --import tsx scripts/journeytest.mjs",
    "db:seed:structure": "node scripts/sync-db-provider.mjs && tsx prisma/seed.ts",
    "db:seed:demo": "node scripts/sync-db-provider.mjs && tsx prisma/seed-demo.ts",
    "roles:backfill": "node scripts/sync-db-provider.mjs && tsx scripts/roles-backfill.ts",
    "shelltest": "node scripts/sync-db-provider.mjs && node --import tsx scripts/shelltest.mjs",
    "tenanttest": "node scripts/sync-db-provider.mjs && node --import tsx scripts/tenanttest.mjs",
    "daytest": "node scripts/sync-db-provider.mjs && node --import tsx scripts/daytest.mjs",
    "leadtest": "node scripts/sync-db-provider.mjs && node --import tsx scripts/leadtest.mjs",
    "outreachtest": "node scripts/sync-db-provider.mjs && node --import tsx scripts/outreachtest.mjs",
    "projecttest": "node scripts/sync-db-provider.mjs && node --import tsx scripts/projecttest.mjs",
    "bundlescan": "node scripts/bundle-scan.mjs",
    "assigntest": "node scripts/sync-db-provider.mjs && node --import tsx scripts/assigntest.mjs",
    "portaltest": "node scripts/sync-db-provider.mjs && node --import tsx scripts/portaltest.mjs",
    "billingtest": "node scripts/sync-db-provider.mjs && node --import tsx scripts/billingtest.mjs",
    "notifytest": "node scripts/sync-db-provider.mjs && node --conditions=react-server --import tsx scripts/notifytest.mjs",
    "analyticstest": "node scripts/sync-db-provider.mjs && node --conditions=react-server --import tsx scripts/analyticstest.mjs",
    "reporttest": "node scripts/sync-db-provider.mjs && node --conditions=react-server --import tsx scripts/reporttest.mjs",
    "agenttest": "node scripts/sync-db-provider.mjs && node --import ./scripts/lib/allow-server-only.mjs --import tsx scripts/agenttest.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "lucide-react": "0.454.0",
    "next": "15.5.26",
    "next-auth": "4.24.15",
    "nodemailer": "10.0.12",
    "pdf-lib": "1.17.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "2.5.4",
    "web-push": "^3.6.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.6",
    "@types/nodemailer": "6.4.24",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.26",
    "postcss": "8.5.28",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.14",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "next": {
      "postcss": "$postcss"
    }
  }
}
