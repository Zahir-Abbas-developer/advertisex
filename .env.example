# ---------------------------------------------------------------------------
# Advertise X — environment
#
# Copy to .env and fill in. Everything below is read at runtime; nothing here
# is baked into the client bundle.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
#
# The scheme decides the Prisma provider. `npm run db:provider` (which every
# db/build script runs first) rewrites prisma/schema.prisma to match, because
# Prisma refuses env() in the provider argument.
#
#   Local development (SQLite):
DATABASE_URL="file:./dev.db"
#
#   Production (Neon / Supabase / any Postgres). Neon and Supabase both want
#   sslmode=require; Supabase's pooled connection also wants pgbouncer=true.
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"


# --- Authentication (required) ---------------------------------------------
#
# Generate with: openssl rand -base64 32
# Changing this invalidates every existing session.
NEXTAUTH_SECRET=""

# The canonical origin. Must match the deployed URL exactly, or callbacks and
# cookies break in ways that look like random sign-outs.
NEXTAUTH_URL="http://localhost:3000"


# --- Client credentials vault (required in production) --------------------------
#
# 32 random bytes, base64. Seals every stored client login (AES-256-GCM).
# Production refuses to store or open a credential without it; development
# falls back to a key derived from NEXTAUTH_SECRET. Generate with:
#   openssl rand -base64 32
# Losing it makes every stored credential unreadable — keep it in the secret
# manager, not only in Vercel. To rotate: move the current value to
# VAULT_KEY_PREVIOUS, set a new VAULT_KEY; both open, new secrets use the new.
VAULT_KEY=""
# VAULT_KEY_PREVIOUS=""

# Optional: the key signing file links (/f/...). Defaults to one derived from
# NEXTAUTH_SECRET. Rotating it invalidates links already issued (they last 5 min).
# FILE_URL_SECRET=""


# --- File storage (required in production) ------------------------------------
#
# Uploads and generated PDFs. A serverless host's disk is read-only and
# temporary, so production needs an S3-compatible bucket (AWS S3, Cloudflare
# R2, Supabase Storage, MinIO). Without one, production refuses to store files
# (and /api/health reports storage as not configured) rather than losing them.
# S3_BUCKET="advertisex-files"
# S3_REGION="auto"                       # R2: auto · AWS: e.g. us-east-1
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"   # omit for AWS
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PREFIX=""                           # optional folder inside the bucket
#
# A self-hosted server with a persistent, backed-up disk can use it instead:
# STORAGE_DRIVER="local"
# UPLOAD_DIR="/var/lib/advertisex/uploads"   # default ./uploads
#
# Development: PRISMA_QUERY_LOG="1" prints every query (docs/RUNBOOK.md, N+1 checks).

# --- AI (optional) -------------------------------------------------------------
#
# With a key, project briefs are read for required skills (only skills from
# your taxonomy). Without one, everything works deterministically.
# ANTHROPIC_API_KEY=""
# AI_MODEL="claude-sonnet-5"
# AI_ENABLED="false"   # switch AI off even when a key is set
#
# AI employees (Phase 9) use the same key. Every agent also works without it
# (a deterministic rules path). Spend is recorded per run at these prices,
# in dollars per million tokens (defaults: 3 in / 15 out):
# AI_PRICE_INPUT="3"
# AI_PRICE_OUTPUT="15"
#
# Development and the test suites only — both are refused in production:
# AI_PROVIDER="fake"                 # a deterministic stand-in model
# AGENT_FETCH_ALLOW_PRIVATE="true"   # lets the research agent read a local test site
# AGENT_WORKER="off"                 # this process queues runs but never executes them


# --- Application ------------------------------------------------------------
#
# Used to build absolute links inside emails (portal invitations included).
# Falls back to NEXTAUTH_URL. Without SMTP, invitation links are shown to
# the inviter to share by hand.
# APP_URL="https://advertisex.example.com"


# --- Scheduled jobs (required in production) --------------------------------
#
# Vercel Cron sends this as `Authorization: Bearer <secret>` to:
#   /api/cron/evaluate   daily   — deadlines, scoring catch-up, close-out
#   /api/cron/reports    daily   — generates whatever the calendar says is due
#   /api/cron/digest     Mondays — the weekly member digest
#
# Without it, those endpoints accept only a signed-in owner, so the schedule
# silently does nothing. Generate with: openssl rand -hex 32
CRON_SECRET=""


# --- Email (optional) -------------------------------------------------------
#
# Any SMTP provider works — Resend, Postmark, SES and Mailgun all expose SMTP
# credentials. With SMTP_HOST unset, messages are logged and skipped rather
# than failing the request that triggered them, so local development needs
# nothing here.
#
#   Resend:   smtp.resend.com : 587, user "resend", password = API key
#   Postmark: smtp.postmarkapp.com : 587
#
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT="587"
# SMTP_USER="resend"
# SMTP_PASSWORD=""
# EMAIL_FROM="Advertise X <notifications@yourdomain.com>"


# --- Production seed (used once, by npm run db:seed:admin) -------------------
#
# Creates the owner account and the service catalogue — and nothing else. The
# demo seed (npm run db:seed) invents five clients and is for local use only.
#
# ADMIN_PASSWORD must be 12+ characters and is refused if it matches a known
# default such as admin123.
#
# ADMIN_EMAIL="you@advertisex.example"
# ADMIN_PASSWORD=""
# ADMIN_NAME="Your Name"
# ADMIN_JOB_TITLE="Founder"

# --- Web push (optional, Phase 8) -------------------------------------------
#
# Availability checks are time-critical and the in-app banner only reaches
# someone with a tab open. With these set the app pushes to a member's phone
# instead. Generate once with: npx web-push generate-vapid-keys
#
# With any of them unset, /api/push reports configured: false, members are
# never prompted, and everything else works normally.
#
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@advertisex.example"

# --- WhatsApp (optional, Phase 8) -------------------------------------------
#
# Sends the availability check as a template message through the Meta WhatsApp
# Cloud API, in addition to push. Fires for checks only. Unset means a silent
# no-op — the app is fully functional without it.
#
# The template needs exactly one body variable: the time the window closes.
# Members need a phone number in E.164 on their user record.
#
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_TEMPLATE_NAME="availability_check"
# WHATSAPP_TEMPLATE_LANG="en"

# --- Backups (optional, Phase 11) -------------------------------------------
#
# The managed provider's own snapshots are the PRIMARY backup — Neon's
# point-in-time restore, Supabase's daily backups. See README.md.
#
# This is a second copy: set a writable path and schedule /api/cron/backup.
# On Vercel there is no pg_dump and no persistent disk, so the run records
# itself as SKIPPED, which is the honest outcome.
#
# BACKUP_DIR="/var/backups/agency-os"

# --- Payments (Phase 7) — optional, off by default -----------------------------
# Online card payments through Stripe Checkout. Nothing is charged unless
# STRIPE_ENABLED is exactly "true" AND both keys are set. The webhook endpoint
# is /api/webhooks/stripe (event: checkout.session.completed).
# STRIPE_ENABLED="false"
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Email via Resend (Phase 8) — optional ---------------------------------------
# With RESEND_API_KEY (and EMAIL_FROM) set, email goes through Resend's API;
# otherwise SMTP_* above; otherwise it is skipped and noted on the notification.
# RESEND_API_KEY="re_..."

# --- Client data integrations (Phase 8) — off by default -----------------------
# Live sync from Google Ads, Meta, GA4, Search Console and Business Profile is
# switched on per deployment. Until then, results are entered by hand.
# INTEGRATIONS_LIVE="false"
# GOOGLE_CLIENT_ID=""  GOOGLE_CLIENT_SECRET=""  GOOGLE_ADS_DEVELOPER_TOKEN=""
# META_APP_ID=""  META_APP_SECRET=""
# Development only: "Load demo data" on a client's Results (never in production).
# ANALYTICS_MOCK="false"

